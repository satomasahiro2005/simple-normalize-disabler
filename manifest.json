{
  "manifest_version": 3,
  "name": "Simple Normalize Disabler",
  "version": "1.2.0",
  "description": "Turns off YouTube's loudness normalization. Stats for nerds shows the real volume.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://music.youtube.com/*",
        "https://www.youtube-nocookie.com/*"
      ],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}
